# Backend API origin.
# - Dev: used as the Vite dev-server proxy target for /api (so cookies stay same-origin over HTTP).
# - Prod: the origin the frontend calls directly. For cross-site cookie auth you must also
#   set the backend COOKIE_SECURE=true and COOKIE_SAMESITE=None (see backend/.dev.vars.example).
VITE_API_URL=http://localhost:8787
