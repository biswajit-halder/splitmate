{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splitmate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitmate-db",
      "database_id": "c4479e34-caad-4378-a3e0-3c51ae85b7e4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Non-secret configuration only. Never put a secret here: `vars` are
    // committed to source control and uploaded as plain-text bindings.
    "APP_ORIGIN": "https://splitmate.bhalder.workers.dev",
    "COOKIE_SECURE": "true",
    // The SPA and the API live on different workers.dev subdomains, which are
    // cross-site. A SameSite=Lax cookie is NOT sent on cross-site fetches,
    // so production needs SameSite=None (which requires Secure).
    "COOKIE_SAMESITE": "None"
  }
}
