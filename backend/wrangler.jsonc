{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splitmate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitmate-db",
      "database_id": "c4479e34-caad-4378-a3e0-3c51ae85b7e4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "JWT_SECRET": "dev-only-secret-change-me",
    "APP_ORIGIN": "https://splitmate.mytrading.workers.dev",
    "COOKIE_SECURE": "true"
  }
}
