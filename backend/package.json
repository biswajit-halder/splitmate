{
  "name": "splitmate-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "wrangler d1 execute splitmate-db --local --file=./seed/demo_seed.sql",
    "seed:generate": "node scripts/generate-demo-seed.mjs",
    "cleanup:demo": "wrangler d1 execute splitmate-db --remote --file=./scripts/cleanup_demo.sql"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
